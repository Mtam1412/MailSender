          <component id="31870" class="javax.swing.JTextField" binding="txtSearch">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="150" height="-1"/></grid></constraints>
            <properties>
              <font name="Segoe UI" size="14" style="0"/>
            </properties>
          </component>
          <component id="7b52b" class="javax.swing.JComboBox" binding="cboStatusFilter">
