              <foreground color="-10193781"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="d4ff6" binding="cardFilter" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="12" left="12" bottom="12" right="12"/>
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="none"/>
