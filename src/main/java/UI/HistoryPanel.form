    <properties>
      <background color="-788740"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="92450" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="2" vgap="2">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
        <properties>
          <background color="-788740"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="40d0b" class="javax.swing.JLabel" binding="lblTitle">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
            <properties>
              <text value="Lịch sử gửi"/>
              <font name="Segoe UI" size="26" style="1"/>
              <foreground color="-14796178"/>
            </properties>
          </component>
          <component id="cb5d6" class="javax.swing.JLabel" binding="lblSubtitle">
